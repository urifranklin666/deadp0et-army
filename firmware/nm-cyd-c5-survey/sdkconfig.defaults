CONFIG_IDF_TARGET="esp32c5"

# ESP32-C5-WROOM-1: 16 MB flash, 8 MB quad PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Wi-Fi: scanning only, never connects. Country code and scan parameters are
# under "NM-CYD-C5 Wi-Fi Survey" in menuconfig.
CONFIG_ESP_WIFI_ENABLE_WIFI_RX_STATS=n

# LVGL 9 through Kconfig (no lv_conf.h). RGB565 to match the panel.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_12=y
CONFIG_LV_USE_OBSERVER=n

# XPT2046: resistive panel, one touch point, pressure gate.
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=1
CONFIG_XPT2046_Z_THRESHOLD=400

CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
